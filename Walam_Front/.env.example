# Configuración LOCAL del front (Vite). Copiar a Walam_Front/.env.local (ignorado por git):
#   cp Walam_Front/.env.example Walam_Front/.env.local
# Vite solo expone al navegador las variables con prefijo VITE_.

# URL base del backend. ⚠️ Hoy el código NO la usa: las llamadas apuntan a producción (Render)
# hasta que se complete docs/tasks/T-002. El valor sirve tal cual con ./scripts/dev.sh y docker compose.
VITE_API_URL=http://localhost:8080
