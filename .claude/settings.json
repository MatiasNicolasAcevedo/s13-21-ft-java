      "Bash(./scripts/dev.sh --down)",
      "Bash(docker compose up -d --wait:*)",
      "Bash(docker compose ps:*)",
      "Bash(./mvnw -B clean verify:*)",
      "Bash(./mvnw -B test:*)",
      "Bash(./mvnw test:*)",
      "Bash(npm ci:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
