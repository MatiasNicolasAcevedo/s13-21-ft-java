# Configuración LOCAL del backend (Walam). Copiar a Walam/.env (ignorado por git):
#   cp Walam/.env.example Walam/.env
# La lee spring-dotenv desde el directorio de trabajo al correr ./mvnw spring-boot:run dentro de Walam/.
# Los valores sirven tal cual con el docker-compose.yml de la raíz. Nunca pongas acá credenciales reales.

# URL JDBC de PostgreSQL (servicio `db` del docker-compose, puerto publicado en localhost)
DB_URL=jdbc:postgresql://localhost:5432/walam
# Usuario de la DB local (igual a POSTGRES_USER del compose)
DB_USERNAME=walam
# Contraseña de la DB local (igual a POSTGRES_PASSWORD del compose)
DB_PASSWORD=walam_local_pw
